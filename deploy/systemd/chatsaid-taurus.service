[Unit]
Description=ChatSaid Taurus Forge
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/chatsaid-taurus
ExecStart=/opt/chatsaid-taurus/scripts/start.sh
Restart=always
RestartSec=3
User=taurus
Group=taurus
Environment=TAURUS_HOST=0.0.0.0
Environment=TAURUS_PORT=7847
Environment=TAURUS_DATA_DIR=/var/lib/chatsaid-taurus
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chatsaid-taurus /opt/chatsaid-taurus/.local

[Install]
WantedBy=multi-user.target
