# Server
TAURUS_PORT=7847
TAURUS_HOST=0.0.0.0
TAURUS_DATA_DIR=./data

# Optional OpenAI-compatible local model endpoint.
# Docker Model Runner and llama.cpp servers can both be configured here.
TAURUS_LLM_URL=http://localhost:12434/engines/v1/chat/completions
TAURUS_LLM_MODEL=ai/qwen2.5-coder
TAURUS_LLM_API_KEY=
TAURUS_USE_LLM_ARTIFACTS=0

# Optional local whisper.cpp command. {input} and {output} are replaced safely.
# The command must write {output}.txt or print the transcript to stdout.
TAURUS_WHISPER_COMMAND=whisper-cli -m ./models/ggml-base.en.bin -f {input} -otxt -of {output}

# Agent writes are read-only by default.
TAURUS_AGENT_WRITE=0
